# ============================================================
#  説明会ウェビナーシステム 環境変数
#  このファイルを .env にコピーして値を埋めてください
# ============================================================

# --- 公開URL（LINEに送る視聴リンクの組み立てに使う。末尾スラッシュなし） ---
BASE_URL=https://webinar.example.com
PORT=3000

# --- LINE Messaging API（LINE Developers > チャネル基本設定 / Messaging API設定） ---
# 空のままだと「ドライラン」で起動します（実送信せずDBにログのみ／ローカル検証用）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# 公式アカウントのベーシックID（@付き）。例: @123abcde
LINE_BASIC_ID=
# 友だち追加URL（例: https://lin.ee/xxxxxxx）。未設定なら LINE_BASIC_ID から自動生成
LINE_ADD_FRIEND_URL=

# --- 管理画面 ---
ADMIN_USER=admin
ADMIN_PASS=change-me-now
# Cookie署名用。openssl rand -hex 32 などで生成した値に必ず変更してください
SESSION_SECRET=change-me-to-a-long-random-string

# --- 保存先 ---
DB_PATH=./data/webinar.db
MEDIA_DIR=./media

# --- リマインド送信のON/OFF（3時間前は要件のため常時ON・変更不可） ---
NOTIFY_CONFIRM=on
NOTIFY_REMIND_1D=on
NOTIFY_REMIND_10M=on
NOTIFY_START=off
NOTIFY_FOLLOWUP=off

# --- ワーカー（通知送信ループ）の実行間隔ミリ秒 ---
WORKER_INTERVAL_MS=20000
