{
  "name": "antai-webinar",
  "version": "1.0.0",
  "private": true,
  "description": "説明会の予約サイト × LINE公式アカウント連携 × 疑似ライブ(simulive)ウェビナー。Node.js と Cloudflare Workers の両方で動く。",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "seed": "node --disable-warning=ExperimentalWarning src/seed.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "cf:db:create": "npx --yes wrangler d1 create antai-webinar",
    "cf:db:init": "npx --yes wrangler d1 execute antai-webinar --remote --file=src/schema.sql",
    "cf:dev": "npx --yes wrangler dev",
    "cf:deploy": "npx --yes wrangler deploy",
    "cf:logs": "npx --yes wrangler tail",
    "cf:media:create": "npx --yes wrangler r2 bucket create antai-webinar-media",
    "cf:media:put": "node scripts/put-media.mjs",
    "cf:media:list": "npx --yes wrangler r2 object list antai-webinar-media --remote"
  }
}
