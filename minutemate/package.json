{
  "name": "minutemate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "無料枠だけで動く全自動ミーティング秘書 (自動入室・録音・議事録・タスク・事業別整理・進捗レポート)",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "auth": "tsx src/google.ts auth",
    "bot:login": "tsx src/bot/run.ts login",
    "bot": "tsx src/bot/run.ts",
    "report": "tsx src/secretary.ts report",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "googleapis": "^144.0.0",
    "marked": "^12.0.2",
    "node-cron": "^3.0.3",
    "playwright": "^1.47.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
