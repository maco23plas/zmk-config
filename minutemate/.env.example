# ===== 基本 =====
TZ=Asia/Tokyo
DATA_DIR=data

# ===== Google OAuth (無料: Google Cloud Console で OAuth クライアント作成) =====
# 有効化する API: Google Calendar API / Gmail API / Google Drive API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_PORT=8790
# 監視するカレンダー (カンマ区切り。primary = 自分のメインカレンダー)
CALENDAR_IDS=primary

# ===== ボット =====
BOT_NAME=議事録Bot（録音中）
# Bot 専用の無料 Gmail アカウント (bot:login でこのアカウントでログインする)
BOT_EMAIL=
# true にすると検知した予定に BOT_EMAIL を自動招待する (Meet にノックなしで入れる)
AUTO_INVITE_BOT=true
# all = ポリシーに合う全会議に自動入室 / off = 手動のみ
JOIN_MODE=all
# タイトルがこの正規表現に一致する会議はスキップ
EXCLUDE_TITLE_REGEX=1on1|面接|面談
JOIN_LEAD_MIN=2
ADMIT_TIMEOUT_MIN=12
MAX_MEETING_MIN=180
# サーバー運用時は false のまま xvfb-run を使う (README 参照)
HEADLESS=false
# 空なら Playwright 同梱の Chromium。手元の Chrome/Chromium を使うならパスを指定
CHROMIUM_PATH=
CHAT_ANNOUNCE=こんにちは、議事録Botです。この会議を録音し、終了後に議事録を参加者へ共有します。

# ===== 文字起こし (どちらも無料) =====
# groq = Groq 無料枠の Whisper (高速・高精度・推奨) / local = faster-whisper (完全ローカル)
STT_PROVIDER=groq
GROQ_API_KEY=
# local のときのモデル (tiny/base/small/medium)
WHISPER_MODEL=small

# ===== LLM (gemini 無料枠を推奨) =====
# gemini / groq / anthropic / ollama
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# ===== 配信 =====
# 議事録・レポートの送り先 (カンマ区切り)
MAIL_TO=you@example.com
# true にすると会議の参加者全員にも議事録メールを送る
MAIL_ATTENDEES=false
SLACK_WEBHOOK_URL=
# Google Drive の保存先フォルダ ID (空なら Drive アップロードなし)
DRIVE_FOLDER_ID=
# 共有リンクを「リンクを知っている全員」に公開するか
DRIVE_SHARE_ANYONE=true
# 録音ファイルも Drive に上げるか
UPLOAD_RECORDING=true

# ===== 秘書機能 =====
# 次回会議の何分前に事前ブリーフを送るか
BRIEF_LEAD_MIN=60
# 週次進捗レポートの cron (月曜 8:00)
WEEKLY_REPORT_CRON=0 8 * * 1

# ===== Web ダッシュボード =====
WEB_PORT=8788
# 設定すると Basic 認証がかかる (ユーザー名は任意)
WEB_PASSWORD=
PUBLIC_URL=http://localhost:8788
